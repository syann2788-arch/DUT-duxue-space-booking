# Docker Compose interpolation only. Copy to repository-root .env, chmod 600.
# Do NOT use this file as backend/.env (direct Python has a separate template).
APP_ENV=production
# Generate different values with: openssl rand -hex 32
# Hex passwords avoid URL-reserved characters in the Compose DATABASE_URL.
POSTGRES_PASSWORD=
SECRET_KEY=
CORS_ORIGINS=https://space-api.example.edu.cn
WECHAT_APP_ID=wx78c441ce72d765fc
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_SUBMITTED=
WECHAT_TEMPLATE_REVIEW=
WECHAT_TEMPLATE_REMINDER=
WECHAT_TEMPLATE_RESTRICTION=
# Absolute host paths; backup identity directory is mounted read-only.
BACKUP_DIR=./backups
BACKUP_KEY_DIR=./backup-keys
BACKUP_AGE_RECIPIENT=
BACKUP_SOURCE_COMMIT=
