[Unit]
Description=Duxue booking worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duxue
Group=duxue
WorkingDirectory=/srv/duxue/app/backend
ExecStart=/srv/duxue/app/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
