.hdr { padding: 28rpx 0 0; }
.hname { font-size: 34rpx; font-weight: 700; color: #6b2d8e; display: block; }
.hinfo { font-size: 24rpx; color: #aaa; display: block; margin-top: 4rpx; }

.date-nav { display: flex; align-items: center; justify-content: center; gap: 32rpx; margin: 28rpx 0; }
.arr-btn { font-size: 26rpx; color: #6b2d8e; padding: 12rpx 20rpx; background: #f5eef9; border-radius: 10rpx; }
.date-text { font-size: 30rpx; font-weight: 600; }

.slots { display: flex; flex-wrap: wrap; gap: 6rpx; margin-bottom: 18rpx; }
.sitem { width: calc(25% - 4.5rpx); padding: 10rpx 4rpx; text-align: center; border-radius: 10rpx; border: 2rpx solid transparent; box-sizing: border-box; }
.sitem.open { background: #faf6fd; border-color: #e0cef0; }
.sitem.busy { background: #f5f5f5; border-color: #eee; }
.sitem.sel { background: #6b2d8e; border-color: #6b2d8e; color: #fff; }

.stime { font-size: 20rpx; font-weight: 600; display: block; }
.stag { font-size: 18rpx; display: block; margin-top: 2rpx; }
.sitem.open .stag { color: #5a2478; }
.sitem.busy .stag { color: #999; }
.sitem.sel .stag { color: #e8d5f5; }
.sreason { font-size: 16rpx; display: block; color: #aaa; margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.summ { background: #fef6e7; padding: 16rpx 20rpx; border-radius: 12rpx; font-size: 24rpx; color: #b7791f; margin-bottom: 16rpx; font-weight: 500; }
.rules { font-size: 22rpx; color: #ccc; line-height: 2; margin-bottom: 24rpx; white-space: pre-line; }

.mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.35); z-index:99; display:flex; align-items:center; justify-content:center; }
.popup { background:#fff; border-radius:18rpx; padding:36rpx; width:560rpx; }
.pop-title { font-size:32rpx; font-weight:700; color:#6b2d8e; text-align:center; display:block; margin-bottom:28rpx; }
.pop-row { display:flex; justify-content:space-between; align-items:center; padding:18rpx 0; border-bottom:1rpx solid #f5f5f5; }
.pop-lbl { font-size:26rpx; color:#999; }
.pop-val { font-size:26rpx; color:#333; font-weight:500; }
