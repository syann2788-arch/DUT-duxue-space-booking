.reserve-page { min-height: 100vh; padding: 4rpx 0 44rpx; background: #f6f5f8; }

.hero-card { padding: 34rpx 30rpx; background: linear-gradient(135deg, #5b237a, #7b3d9b); }
.hero-title { display: block; color: #fff; font-size: 38rpx; font-weight: 700; }
.hero-sub { display: block; margin-top: 8rpx; color: rgba(255,255,255,.76); font-size: 23rpx; line-height: 1.6; }

.section-head { display: flex; align-items: center; margin-bottom: 24rpx; }
.step { width: 42rpx; height: 42rpx; margin-right: 14rpx; border-radius: 50%; background: #6b2d8e; color: #fff; text-align: center; line-height: 42rpx; font-size: 22rpx; font-weight: 700; }
.section-title { font-size: 30rpx; font-weight: 700; color: #3f3446; }

.scene-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.scene-card { width: calc(50% - 7rpx); min-height: 150rpx; padding: 20rpx; border: 2rpx solid #ece6f0; border-radius: 16rpx; box-sizing: border-box; background: #fff; }
.scene-card.selected { border-color: #6b2d8e; background: #f8f1fc; box-shadow: 0 4rpx 16rpx rgba(107,45,142,.10); }
.scene-icon { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 12rpx; background: #eee8f1; color: #6b2d8e; font-size: 22rpx; font-weight: 700; }
.scene-card.selected .scene-icon { background: #6b2d8e; color: #fff; }
.scene-name { display: block; margin-top: 10rpx; color: #403746; font-size: 27rpx; font-weight: 700; }
.scene-mode { display: block; margin-top: 3rpx; color: #9c91a3; font-size: 20rpx; }

.allocation { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 12rpx; background: #f7f3f9; }
.allocation-title { display: block; color: #6b2d8e; font-size: 22rpx; font-weight: 700; }
.allocation-text { display: block; margin-top: 5rpx; color: #74697b; font-size: 22rpx; line-height: 1.55; }

.people-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0ebf2; }
.people-label { display: block; color: #4d4452; font-size: 26rpx; font-weight: 600; }
.people-hint { display: block; margin-top: 4rpx; color: #aaa1af; font-size: 20rpx; }
.people-input-wrap { display: flex; align-items: center; padding: 6rpx 14rpx; border: 2rpx solid #ddd3e2; border-radius: 10rpx; background: #fff; }
.people-input { width: 90rpx; height: 54rpx; color: #4c3d53; font-size: 28rpx; text-align: right; }
.people-unit { margin-left: 6rpx; color: #8e8394; font-size: 24rpx; }
.study-tip { margin-top: 18rpx; color: #8f8297; font-size: 22rpx; }

.date-nav { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 0 22rpx; }
.arr-btn { color: #6b2d8e; padding: 12rpx 18rpx; border-radius: 10rpx; background: #f5eef9; font-size: 23rpx; }
.arr-btn.disabled { color: #cbc2d0; background: #f7f7f7; }
.date-center { text-align: center; }
.date-text { display: block; color: #403746; font-size: 28rpx; font-weight: 700; }
.date-label { display: block; margin-top: 2rpx; color: #a094a7; font-size: 20rpx; }

.slot-legend { display: flex; justify-content: flex-end; gap: 20rpx; margin-bottom: 14rpx; color: #99909f; font-size: 19rpx; }
.slot-legend view { display: flex; align-items: center; }
.legend-dot { display: inline-block; width: 14rpx; height: 14rpx; margin-right: 5rpx; border-radius: 4rpx; }
.open-dot { background: #f5ecfa; border: 1rpx solid #ceb6dc; }
.selected-dot { background: #6b2d8e; }
.busy-dot { background: #ededed; }

.slots { display: flex; flex-wrap: wrap; gap: 8rpx; }
.slot { width: calc(25% - 6rpx); padding: 13rpx 4rpx; border: 2rpx solid transparent; border-radius: 10rpx; box-sizing: border-box; text-align: center; }
.slot.open { background: #fbf7fd; border-color: #ddcde7; }
.slot.busy { background: #f3f3f3; border-color: #ededed; }
.slot.selected { background: #6b2d8e; border-color: #6b2d8e; color: #fff; }
.slot-time { display: block; font-size: 18rpx; font-weight: 600; white-space: nowrap; }
.slot-state { display: block; margin-top: 3rpx; font-size: 17rpx; }
.slot.open .slot-state { color: #6b2d8e; }
.slot.busy .slot-time, .slot.busy .slot-state { color: #bdbdbd; }
.slot.selected .slot-state { color: #eadcf2; }

.loading, .load-error, .empty { padding: 70rpx 0; color: #aaa1af; font-size: 24rpx; text-align: center; }
.load-error { color: #6b2d8e; }
.summary { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 17rpx 20rpx; border-radius: 12rpx; background: #fff5df; color: #9a671d; font-size: 23rpx; }
.summary-duration { font-size: 26rpx; font-weight: 700; }
.rules { margin: 22rpx 2rpx; }
.rules text { display: block; color: #aaa1af; font-size: 21rpx; line-height: 1.8; }
.rules text::before { content: '· '; color: #6b2d8e; }
.next-btn { margin-top: 8rpx; }
