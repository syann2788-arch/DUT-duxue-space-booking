.page-my {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f6f5f8;
  padding-bottom: 120rpx;
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
.profile { display: flex; align-items: center; padding: 40rpx 28rpx 30rpx; background: #fff; }
.avatar { width: 80rpx; height: 80rpx; flex: none; border-radius: 50%; background: #f5eef9; display: flex; align-items: center; justify-content: center; color: #6b2d8e; font-size: 36rpx; font-weight: 700; }
.profile-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.profile-name { display: block; color: #2c2c2c; font-size: 32rpx; font-weight: 700; }
.profile-meta { display: block; margin-top: 5rpx; color: #999; font-size: 24rpx; }
.ban-state { display: inline-block; margin-top: 8rpx; padding: 4rpx 12rpx; border-radius: 16rpx; font-size: 20rpx; }
.ban-state.normal { color: #39834d; background: #ebf7ee; }
.ban-state.banned { color: #fff; background: #e0556a; }

.quick-actions { display: flex; gap: 12rpx; margin: 20rpx; }
.quick-card { flex: 1; min-width: 0; padding: 22rpx 10rpx; border-radius: 16rpx; background: #f5eef9; text-align: center; }
.quick-card.primary { background: #6b2d8e; }
.quick-card.admin { background: #fef4d9; }
.quick-title { display: block; color: #6b2d8e; font-size: 25rpx; font-weight: 700; }
.quick-sub { display: block; margin-top: 5rpx; color: #a89caf; font-size: 18rpx; }
.quick-card.primary .quick-title, .quick-card.primary .quick-sub { color: #fff; }
.quick-card.primary .quick-sub { opacity: .72; }
.quick-card.admin .quick-title { color: #a76900; }
.quick-card.admin .quick-sub { color: #bd9148; }

.counselor-card { margin: 0 20rpx 20rpx; padding: 20rpx; border-radius: 16rpx; background: #fff1f2; text-align: center; }
.counselor-title { display: block; color: #b83b50; font-size: 23rpx; font-weight: 700; }
.counselor-sub { display: block; margin-top: 4rpx; color: #d07886; font-size: 20rpx; }

.tabs-scroll { width: auto; margin: 0 20rpx; border-radius: 16rpx 16rpx 0 0; background: #fff; white-space: nowrap; }
.tabs { display: flex; min-width: 100%; }
.tab { flex: 1; min-width: 120rpx; padding: 24rpx 8rpx; color: #aaa2ad; font-size: 25rpx; text-align: center; }
.tab.active { color: #6b2d8e; font-weight: 700; border-bottom: 4rpx solid #6b2d8e; }

.reservation-list { margin: 0 20rpx; }
.reservation-card { padding: 24rpx 26rpx; border-top: 1rpx solid #f0edf2; background: #fff; }
.reservation-card:last-child { border-radius: 0 0 16rpx 16rpx; }
.reservation-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.room-main { flex: 1; min-width: 0; }
.room-name { display: block; color: #2c2c2c; font-size: 28rpx; font-weight: 700; }
.scene { display: block; margin-top: 4rpx; color: #aaa1ae; font-size: 20rpx; }
.status { flex: none; padding: 5rpx 13rpx; border-radius: 16rpx; color: #777; background: #f0f0f0; font-size: 20rpx; }
.s-pending { color: #a66b00; background: #fff3d5; }
.s-approved { color: #6b2d8e; background: #f1e7f7; }
.s-rejected, .s-cleanup_rejected, .s-missed { color: #bd3c50; background: #fdebed; }
.s-cancelled { color: #999; background: #f1f1f1; }
.s-in_use { color: #26783c; background: #e7f5ea; }
.s-cleanup_pending { color: #a66112; background: #fff0dc; }
.s-completed { color: #35734a; background: #eaf4ed; }
.time, .purpose { display: block; margin-top: 10rpx; color: #827a86; font-size: 23rpx; }
.purpose { color: #aaa1ae; }
.note { display: block; margin-top: 12rpx; padding: 12rpx 14rpx; border-radius: 8rpx; color: #815e41; background: #faf4ec; font-size: 21rpx; }
.warning-note { color: #aa3c50; background: #fff0f2; }

.actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; margin-top: 18rpx; }
.action-btn { width: auto; min-width: 118rpx; margin: 0; padding: 0 20rpx; border-radius: 10rpx; font-size: 22rpx; line-height: 58rpx; }
.action-btn::after { border: none; }
.action-btn.checkin { color: #fff; background: #6b2d8e; }
.action-btn.cancel { color: #d04a61; background: #fff; border: 1rpx solid #e8a6b1; }
.action-btn.cleanup { color: #fff; background: #d97828; }
.action-btn.rebook { color: #6b2d8e; background: #f5eef9; }
.action-btn[disabled] { opacity: .55; }
.empty { padding: 100rpx 0; color: #c2bcc5; font-size: 27rpx; text-align: center; }
