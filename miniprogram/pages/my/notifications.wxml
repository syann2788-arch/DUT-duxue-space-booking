<view class="messages"><text class="muted">这里保留业务通知；微信拒绝授权或发送失败时仍可查看。</text><view wx:for="{{items}}" wx:key="id" class="card"><text>{{item.title}}</text><text>{{item.reason}}</text><text wx:if="{{item.room}}">{{item.room}} {{item.date}} {{item.time}}</text><text wx:if="{{item.endsAt}}">结束时间：{{item.endsAt}} · 时长：{{item.duration}}</text><text class="muted">微信发送：{{item.statusLabel}}</text></view><text wx:if="{{!items.length&&!busy}}">暂无消息</text><text wx:if="{{error}}">{{error}}</text><button bindtap="reload" disabled="{{busy}}">刷新</button><button wx:if="{{hasMore}}" bindtap="more" disabled="{{busy}}">加载更多</button></view>