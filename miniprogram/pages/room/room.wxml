<view wx:if="{{room}}" class="page">
  <view class="card room-card">
    <view class="room-head">
      <view class="room-title">
        <text class="room-code">{{room.room_code}}</text>
        <text class="room-name">{{room.name}}</text>
      </view>
      <text wx:if="{{canStartReservation}}" class="reserve-entry" bindtap="goReserve">发起预约</text>
    </view>
    <view class="tags">
      <text class="category-tag">{{room.category}}</text>
      <text wx:if="{{room.has_fridge}}" class="feature-tag fridge">有冰箱</text>
      <text wx:if="{{room.has_instruments}}" class="feature-tag instrument">有乐器</text>
    </view>
    <text class="description">{{room.description}}</text>
    <text wx:if="{{canStartReservation}}" class="allocation-hint">预约时请选择使用场景，系统将按规则与空闲情况自动分配空间，不保证分配本房间。</text>
  </view>

  <view wx:if="{{room.is_public}}" class="card public-card">
    <text class="section-label">当前状态</text>
    <text class="public-status" style="color:{{statusColor}}">{{statusText}}</text>
    <view wx:if="{{isAdmin}}" class="status-actions">
      <button class="status-btn free" bindtap="setStatus" data-s="free">空闲</button>
      <button class="status-btn busy" bindtap="setStatus" data-s="busy">较满</button>
      <button class="status-btn crowded" bindtap="setStatus" data-s="crowded">已满</button>
    </view>
  </view>

  <view wx:if="{{!room.can_reserve}}" class="card notice notice-closed">
    <text>该空间不参与预约分配</text>
  </view>
  <view wx:elif="{{room.who_can_reserve === 'counselor' && !isCounselor}}" class="card notice notice-counselor">
    <text>该空间仅限辅导员发起预约</text>
  </view>

  <view wx:if="{{room.can_reserve}}" class="card timeline-card">
    <view class="timeline-head">
      <text class="section-title">今日占用情况</text>
      <text class="timeline-date">{{todayDate}}</text>
    </view>
    <text class="privacy-note">仅展示时段是否占用，不展示预约人身份、班级或申请用途。</text>

    <text wx:if="{{slotsLoading}}" class="timeline-state">加载中...</text>
    <text wx:elif="{{slotsError}}" class="timeline-state error">{{slotsError}}</text>
    <block wx:else>
      <view wx:if="{{totalSlots}}" class="timeline-bar">
        <block wx:for="{{timelineSegments}}" wx:key="start">
          <view class="timeline-segment {{item.available ? 'available' : 'occupied'}}" style="width:{{(item.end-item.start)/totalSlots*100}}%;border-radius:{{item.borderRadius}}"></view>
        </block>
      </view>
      <view wx:if="{{axisLabels.length}}" class="time-axis">
        <text wx:for="{{axisLabels}}" wx:key="*this">{{item}}</text>
      </view>

      <view wx:if="{{todayBlocks.length}}" class="occupied-list">
        <view wx:for="{{todayBlocks}}" wx:key="start" class="occupied-row">
          <view class="occupied-mark"></view>
          <text class="occupied-title">已占用</text>
          <text class="occupied-time">{{item.timeLabel}}</text>
        </view>
      </view>
      <text wx:else class="timeline-state empty">今日暂无占用</text>
    </block>
  </view>

  <view class="card message-card">
    <view class="message-head">
      <text class="section-title">空间留言板</text>
      <text class="write-message" bindtap="openPost">写留言</text>
    </view>
    <text class="message-rule">仅实际使用过该空间的用户可以发布留言。</text>

    <text wx:if="{{messagesLoading}}" class="message-state">加载中...</text>
    <text wx:elif="{{messagesError}}" class="message-state error" bindtap="loadMessages">{{messagesError}}</text>
    <block wx:else>
      <view wx:for="{{messages}}" wx:for-item="message" wx:key="id" class="message-row">
        <view class="message-meta">
          <text class="message-author">{{message.author_name}}</text>
          <text class="message-time">{{message.createdAtLabel}}</text>
        </view>
        <text wx:if="{{message.content}}" class="message-content">{{message.content}}</text>
        <view wx:if="{{message.photo_urls.length}}" class="message-photos">
          <image wx:for="{{message.photo_urls}}" wx:for-item="photo" wx:key="*this" class="message-photo {{message.photo_urls.length===1?'single':''}}" src="{{photo}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{photo}}" data-urls="{{message.photo_urls}}"/>
        </view>
      </view>
      <text wx:if="{{!messages.length}}" class="message-state">暂无留言，成为第一个留言的人吧</text>
    </block>
  </view>

  <view wx:if="{{showPost}}" class="message-mask" bindtap="closePost">
    <view class="message-popup" catchtap="stopPopup">
      <view class="popup-head">
        <text class="popup-title">空间留言</text>
        <text class="popup-close" bindtap="closePost">取消</text>
      </view>
      <textarea class="message-input" placeholder="分享你的使用感受，或上传空间照片..." value="{{postContent}}" bindinput="onPostContent" maxlength="500" cursor-spacing="30"/>
      <text class="message-count">{{postContent.length||0}}/500</text>

      <view wx:if="{{postPhotoDisplay}}" class="post-photo-wrap">
        <image class="post-photo" src="{{postPhotoDisplay}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{postPhotoDisplay}}"/>
        <text class="remove-photo" bindtap="removePhoto">×</text>
      </view>

      <view class="popup-actions">
        <button class="photo-button" bindtap="choosePhoto" loading="{{photoUploading}}" disabled="{{posting||photoUploading}}">{{postPhoto?'换照片':'添加照片'}}</button>
        <button class="publish-button" bindtap="submitPost" loading="{{posting}}" disabled="{{posting||photoUploading}}">发布</button>
      </view>
    </view>
  </view>
</view>
