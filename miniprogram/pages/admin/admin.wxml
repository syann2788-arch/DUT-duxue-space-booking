<view class="admin-page">
  <view wx:if="{{!authorized}}" class="auth-state">
    <text>正在校验管理员身份...</text>
  </view>

  <block wx:else>
    <view class="admin-hero">
      <text class="admin-hero-title">管理员工作台</text>
      <text class="admin-hero-sub">预约、清扫、用户与空间规则统一管理</text>
    </view>

    <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
      <view class="tabs-inner">
        <text wx:for="{{tabs}}" wx:key="key" class="tab {{activeTab===item.key?'active':''}}" data-key="{{item.key}}" bindtap="switchTab" aria-role="tab" aria-selected="{{activeTab===item.key}}" aria-label="切换到{{item.label}}">{{item.label}}</text>
      </view>
    </scroll-view>

    <view wx:if="{{loading}}" class="loading-bar" aria-role="status">正在加载...</view>
    <view wx:if="{{loadError&&!loading}}" class="load-error-card" aria-role="alert">
      <text>{{loadError}}</text>
      <button bindtap="retryActiveTab" aria-label="重新加载当前管理页面">重新加载</button>
    </view>

    <!-- 概览 -->
    <block wx:if="{{activeTab==='overview'}}">
      <view class="stat-grid">
        <view class="stat-card purple"><text class="stat-number">{{stats.pending}}</text><text class="stat-label">待审核预约</text></view>
        <view class="stat-card orange"><text class="stat-number">{{stats.cleanup_pending}}</text><text class="stat-label">待复核清扫</text></view>
        <view class="stat-card blue"><text class="stat-number">{{stats.total_users}}</text><text class="stat-label">总用户</text></view>
        <view class="stat-card green"><text class="stat-number">{{stats.today}}</text><text class="stat-label">今日预约</text></view>
      </view>

      <view class="admin-card action-card">
        <view>
          <text class="card-title">预约记录 Excel</text>
          <text class="card-desc">导出预约、清扫、违规与限制记录</text>
        </view>
        <button class="compact-btn primary" bindtap="exportExcel" aria-label="导出完整预约记录 Excel">导出</button>
      </view>

      <view class="admin-card">
        <text class="card-title">房间签到码</text>
        <text class="card-desc block">复制房间 JSON 后生成二维码，张贴于对应空间。</text>
        <view wx:for="{{qrRooms}}" wx:key="id" class="simple-row">
          <text class="simple-main">{{item.code}} {{item.name}}</text>
          <text class="text-action" data-id="{{item.id}}" bindtap="copyRoomCode">复制签到码</text>
        </view>
        <text wx:if="{{!qrRooms.length}}" class="empty-small">暂无可预约房间</text>
      </view>

      <view class="admin-card placeholder-card" bindtap="importCounselors">
        <view>
          <text class="card-title">辅导员 CSV 导入</text>
          <text class="card-desc block">从微信文件中选择 UTF-8 CSV，导入后妥善保存新账号凭据。</text>
        </view>
        <text class="placeholder-arrow">›</text>
      </view>
    </block>

    <!-- 预约审核 -->
    <block wx:if="{{activeTab==='review'}}">
      <view class="section-toolbar">
        <text>待审核 {{pendingTotal}} 条，已加载 {{pendingReservations.length}} 条</text>
        <view class="toolbar-actions">
          <text class="text-action" bindtap="toggleAllPending">{{selectedPendingIds.length===pendingReservations.length&&pendingReservations.length?'取消全选':'全选'}}</text>
          <text class="text-action" bindtap="loadPendingReservations">刷新</text>
        </view>
      </view>

      <view wx:for="{{pendingReservations}}" wx:key="id" wx:for-index="pendingIndex" class="admin-card reservation-card">
        <view class="reservation-head">
          <view>
            <text class="reservation-room">{{item.room.room_code}} {{item.room.name}}</text>
            <text class="reservation-scene">{{item.sceneLabel}} · {{item.modeLabel}}</text>
          </view>
          <text class="select-pill {{item.selected?'selected':''}}" data-id="{{item.id}}" bindtap="togglePending" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="选择预约，{{item.room.room_code}}，{{item.user.name}}">{{item.selected?'已选':'选择'}}</text>
        </view>
        <text class="detail-line">{{item.user.name}} · {{item.user.student_id}} · 笃学{{item.user.class_name}}</text>
        <text class="detail-line">{{item.user.phone}} · {{item.people_count}}人</text>
        <text class="detail-line strong">{{item.date}}　{{item.timeLabel}}</text>
        <text class="purpose-box">{{item.purpose}}</text>
        <view wx:if="{{item.cardMediaId}}" class="photo-line" data-index="{{pendingIndex}}" bindtap="previewCampusCard">
          <text class="text-action">安全查看玉兰卡照片</text>
          <text class="photo-note">仅管理员可鉴权下载，查看操作会被记录</text>
        </view>
        <view class="inline-actions">
          <button class="compact-btn reject" data-id="{{item.id}}" data-decision="rejected" catchtap="reviewOne">驳回</button>
          <button class="compact-btn approve" data-id="{{item.id}}" data-decision="approved" catchtap="reviewOne">通过</button>
        </view>
      </view>
      <view wx:if="{{!pendingReservations.length&&!loading}}" class="empty-state">暂无待审核预约</view>
      <button wx:if="{{pendingHasMore&&!loading}}" class="load-more-button" bindtap="loadMorePending" aria-label="加载更多待审核预约">加载更多</button>

      <view wx:if="{{selectedPendingIds.length}}" class="batch-bar">
        <text class="batch-count">已选 {{selectedPendingIds.length}} 条</text>
        <button class="batch-btn reject" data-decision="rejected" bindtap="reviewSelected">批量驳回</button>
        <button class="batch-btn approve" data-decision="approved" bindtap="reviewSelected">批量通过</button>
      </view>
    </block>

    <!-- 清扫复核 -->
    <block wx:if="{{activeTab==='cleanup'}}">
      <view class="section-toolbar">
        <text>待复核 {{cleanupTotal}} 条，已加载 {{cleanupItems.length}} 条</text>
        <text class="text-action" bindtap="loadCleanupQueue">刷新</text>
      </view>
      <view wx:for="{{cleanupItems}}" wx:key="id" wx:for-index="cleanupIndex" class="admin-card cleanup-card">
        <text class="reservation-room">{{item.room.room_code}} {{item.room.name}}</text>
        <text class="detail-line">{{item.user.name}} · {{item.user.student_id}} · {{item.sceneLabel}}</text>
        <text class="detail-line strong">{{item.date}}　{{item.timeLabel}}</text>
        <view class="photo-grid">
          <view wx:for="{{item.mediaIds}}" wx:key="*this" wx:for-index="photoIndex" class="cleanup-photo" data-item-index="{{cleanupIndex}}" data-photo-index="{{photoIndex}}" bindtap="previewCleanupPhoto">查看照片 {{photoIndex+1}}</view>
        </view>
        <text wx:if="{{!item.mediaIds.length}}" class="empty-small">该记录没有可查看的照片</text>
        <view class="inline-actions">
          <button class="compact-btn reject" data-id="{{item.cleanup.id}}" data-decision="rejected" bindtap="reviewCleanup">不通过/限制</button>
          <button class="compact-btn approve" data-id="{{item.cleanup.id}}" data-decision="approved" bindtap="reviewCleanup">通过</button>
        </view>
      </view>
      <view wx:if="{{!cleanupItems.length&&!loading}}" class="empty-state">暂无待复核清扫照片</view>
      <button wx:if="{{cleanupHasMore&&!loading}}" class="load-more-button" bindtap="loadMoreCleanup" aria-label="加载更多清扫复核记录">加载更多</button>
    </block>

    <!-- 用户管理 -->
    <block wx:if="{{activeTab==='users'}}">
      <view class="search-card">
        <input class="search-input" value="{{userSearch}}" placeholder="姓名、学号、手机号或班级" aria-label="搜索用户，支持姓名学号手机号或班级" confirm-type="search" bindinput="onUserSearchInput" bindconfirm="searchUsers" />
        <button class="search-button" bindtap="searchUsers" aria-label="搜索用户">搜索</button>
      </view>

      <view wx:if="{{selectedUser}}" class="admin-card selected-user-card">
        <view class="selected-user-head">
          <view>
            <text class="user-name">{{selectedUser.name}}</text>
            <text class="role-tag">{{selectedUser.roleLabel}}</text>
            <text class="user-meta">{{selectedUser.student_id}} · 笃学{{selectedUser.class_name}} · {{selectedUser.phone}}</text>
          </view>
          <text class="text-action" bindtap="refreshSelectedUser">刷新记录</text>
        </view>

        <view class="record-section">
          <text class="sub-title">违约记录（{{violations.length}}）</text>
          <view wx:for="{{violations}}" wx:key="id" class="record-row">
            <view><text class="record-main">{{item.typeLabel}}</text><text class="record-sub">预约号 {{item.reservation_id||'—'}}</text></view>
            <text class="record-time">{{item.createdLabel}}</text>
          </view>
          <text wx:if="{{!violations.length}}" class="empty-small">暂无违约记录</text>
        </view>

        <view class="record-section">
          <text class="sub-title">预约限制（{{restrictions.length}}）</text>
          <view wx:for="{{restrictions}}" wx:key="id" class="restriction-row">
            <view class="restriction-copy">
              <text class="record-main">{{item.levelLabel}} · {{item.is_active?'有效':'已解除'}}</text>
              <text class="record-sub">{{item.reason}}</text>
              <text class="record-sub">{{item.startsLabel}} 至 {{item.endsLabel}}</text>
            </view>
            <text wx:if="{{item.is_active}}" class="danger-action" data-id="{{item.id}}" bindtap="revokeRestriction">解除</text>
          </view>
          <text wx:if="{{!restrictions.length}}" class="empty-small">暂无预约限制</text>
        </view>

        <view class="restriction-form">
          <text class="sub-title">新增预约限制</text>
          <picker range="{{restrictionOptions}}" range-key="label" value="{{restrictionLevelIndex}}" bindchange="onRestrictionLevelChange">
            <view class="form-row"><text>限制级别</text><text class="form-value">{{restrictionLevelLabel}} ›</text></view>
          </picker>
          <view wx:if="{{restrictionForm.level!=='permanent'}}" class="form-row">
            <text>限制天数</text>
            <input class="short-input" type="number" value="{{restrictionForm.days}}" bindinput="onRestrictionDaysInput" />
          </view>
          <textarea class="reason-input" value="{{restrictionForm.reason}}" placeholder="填写限制原因（至少2个字）" maxlength="500" bindinput="onRestrictionReasonInput" />
          <button class="full-purple-button" bindtap="addRestriction">新增限制</button>
        </view>
      </view>

      <view class="section-toolbar"><text>用户共 {{usersTotal}} 人，已加载 {{users.length}} 人</text></view>
      <view wx:for="{{users}}" wx:key="id" wx:for-index="userIndex" class="user-list-row" data-index="{{userIndex}}" bindtap="selectUser" aria-role="button" aria-label="查看用户{{item.name}}，学号{{item.student_id}}">
        <view class="user-avatar">{{item.initial}}</view>
        <view class="user-list-copy">
          <view><text class="user-name small">{{item.name}}</text><text class="role-tag">{{item.roleLabel}}</text></view>
          <text class="user-meta">{{item.student_id}} · 笃学{{item.class_name}} · {{item.phone}}</text>
          <text wx:if="{{item.bannedLabel}}" class="legacy-ban">旧版禁约至 {{item.bannedLabel}}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <view wx:if="{{!users.length&&!loading}}" class="empty-state">没有匹配的用户</view>
      <button wx:if="{{usersHasMore&&!loading}}" class="load-more-button" bindtap="loadMoreUsers" aria-label="加载更多用户">加载更多</button>
    </block>

    <!-- 分房规则 -->
    <block wx:if="{{activeTab==='rules'}}">
      <view class="section-toolbar">
        <view><text>场景分房规则</text><text class="toolbar-note">优先级数字越小越优先</text></view>
        <text class="text-action" bindtap="loadRoomRules">刷新</text>
      </view>
      <view wx:for="{{roomRules}}" wx:key="id" class="admin-card rule-card">
        <view class="rule-head">
          <view><text class="reservation-room">{{item.roomCode}} {{item.roomName}}</text><text class="scene-badge">{{item.sceneLabel}}</text></view>
          <view class="switch-line"><text>启用</text><switch color="#F25B15" checked="{{item.is_enabled}}" data-id="{{item.id}}" bindchange="onRuleEnabledChange" /></view>
        </view>
        <view class="rule-fields">
          <view class="rule-field"><text>优先级</text><input type="number" value="{{item.priority}}" data-id="{{item.id}}" data-field="priority" bindinput="onRuleInput" /></view>
          <view class="rule-field"><text>容量</text><input type="number" value="{{item.capacity}}" data-id="{{item.id}}" data-field="capacity" bindinput="onRuleInput" /></view>
          <picker class="rule-field" range="{{usageModeLabels}}" value="{{item.modeIndex}}" data-id="{{item.id}}" bindchange="onRuleModeChange"><view><text>使用模式</text><text class="form-value">{{item.modeLabel}} ›</text></view></picker>
        </view>
        <button class="full-purple-button compact" data-id="{{item.id}}" bindtap="saveRoomRule">保存此规则</button>
      </view>
      <view wx:if="{{!roomRules.length&&!loading}}" class="empty-state">暂无分房规则</view>
    </block>

    <!-- 系统配置 -->
    <block wx:if="{{activeTab==='settings'}}">
      <view class="section-toolbar">
        <view><text>系统运行参数</text><text class="toolbar-note">保存时由服务器再次校验参数组合</text></view>
        <text class="text-action" bindtap="loadSettings">重载</text>
      </view>
      <view class="admin-card settings-card">
        <view wx:for="{{settingFields}}" wx:key="key" class="setting-row">
          <view class="setting-copy"><text class="setting-label">{{item.label}}</text><text class="setting-key">{{item.key}}</text></view>
          <input class="setting-input" type="{{item.inputType}}" value="{{item.value}}" placeholder="{{item.placeholder}}" data-key="{{item.key}}" bindinput="onSettingInput" />
        </view>
        <button class="full-purple-button" bindtap="saveSettings">保存全部配置</button>
      </view>
    </block>

    <view class="page-spacer"></view>
  </block>
</view>
