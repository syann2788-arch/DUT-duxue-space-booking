<view style="padding-bottom:40rpx">
  <!-- 仪表盘 -->
  <view class="card">
    <text style="font-size:28rpx;font-weight:700;color:#444;margin-bottom:20rpx;display:block">仪表盘</text>
    <view style="display:flex;gap:12rpx;flex-wrap:wrap">
      <view style="flex:1;min-width:calc(50% - 6rpx);background:#f8f3fb;border-radius:12rpx;padding:24rpx;text-align:center">
        <text style="font-size:44rpx;font-weight:700;color:#6b2d8e;display:block">{{stats.todayActive||0}}</text>
        <text style="font-size:22rpx;color:#b0a0c0">今日活跃</text>
      </view>
      <view style="flex:1;min-width:calc(50% - 6rpx);background:#fef6e7;border-radius:12rpx;padding:24rpx;text-align:center">
        <text style="font-size:44rpx;font-weight:700;color:#e67e22;display:block">{{stats.todayMissed||0}}</text>
        <text style="font-size:22rpx;color:#d0a868">今日违约</text>
      </view>
      <view style="flex:1;min-width:calc(50% - 6rpx);background:#f0f4fd;border-radius:12rpx;padding:24rpx;text-align:center">
        <text style="font-size:44rpx;font-weight:700;color:#3b7ad9;display:block">{{stats.totalUsers||0}}</text>
        <text style="font-size:22rpx;color:#8aacd8">总用户</text>
      </view>
      <view style="flex:1;min-width:calc(50% - 6rpx);background:#fdedec;border-radius:12rpx;padding:24rpx;text-align:center">
        <text style="font-size:44rpx;font-weight:700;color:#c0392b;display:block">{{stats.banned||0}}</text>
        <text style="font-size:22rpx;color:#d08888">禁约中</text>
      </view>
    </view>

    <view wx:if="{{stats.popular && stats.popular.length}}" style="margin-top:24rpx">
      <text style="font-size:24rpx;color:#999;display:block;margin-bottom:12rpx">热门房间（本月）</text>
      <view wx:for="{{stats.popular}}" wx:key="name" style="display:flex;justify-content:space-between;padding:12rpx 0;border-bottom:1rpx solid #f5f5f5;font-size:26rpx">
        <text style="color:#444">{{item.name}}</text>
        <text style="color:#6b2d8e;font-weight:600">{{item.count}}次</text>
      </view>
    </view>
  </view>

  <!-- 房间签到码 -->
  <view class="card">
    <text style="font-size:28rpx;font-weight:700;color:#555;margin-bottom:16rpx;display:block">房间签到码</text>
    <text style="font-size:22rpx;color:#aaa;display:block;margin-bottom:16rpx">复制下方JSON，用任意二维码生成工具生成房间签到码，贴在房间门口</text>
    <view wx:for="{{rooms}}" wx:key="id" style="display:flex;justify-content:space-between;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f5f5f5">
      <text style="font-size:26rpx;color:#444">{{item.code}} {{item.name}}</text>
      <text style="font-size:20rpx;color:#fff;background:#6b2d8e;padding:8rpx 16rpx;border-radius:6rpx" bindtap="copyRoomCode" data-id="{{item.id}}">复制签到码</text>
    </view>
  </view>

  <!-- 用户管理 -->
  <view class="card" style="display:flex;justify-content:space-between;align-items:center">
    <text style="font-size:28rpx;font-weight:700;color:#555">用户管理（{{users.length}}人）</text>
    <text style="font-size:22rpx;color:#6b2d8e;padding:8rpx 20rpx;background:#f5eef9;border-radius:8rpx" bindtap="exportCSV">导出CSV</text>
  </view>
  <view wx:for="{{users}}" wx:key="id" class="card" style="margin-top:0">
    <view style="display:flex;justify-content:space-between;align-items:center">
      <view>
        <text style="font-size:28rpx;font-weight:600">{{item.name}}</text>
        <text style="font-size:20rpx;background:#f5eef9;color:#6b2d8e;padding:2rpx 10rpx;border-radius:4rpx;margin-left:10rpx">{{item.rl}}</text>
        <text style="font-size:22rpx;color:#aaa;display:block;margin-top:4rpx">{{item.student_id}} · {{item.class_name}}</text>
      </view>
      <button wx:if="{{!item.banned_until}}" style="background:#e0556a;color:#fff;font-size:22rpx;padding:12rpx 22rpx;border-radius:10rpx;border:none" bindtap="doBan" data-id="{{item.id}}" data-name="{{item.name}}">禁约</button>
      <button wx:else style="background:#27ae60;color:#fff;font-size:22rpx;padding:12rpx 22rpx;border-radius:10rpx;border:none" bindtap="doUnban" data-id="{{item.id}}">解禁</button>
    </view>
    <text wx:if="{{item.banned_until}}" style="font-size:20rpx;color:#e0556a;display:block;margin-top:6rpx">禁约至 {{item.bl}}</text>
  </view>
</view>
