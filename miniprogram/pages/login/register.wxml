<view style="min-height:100vh;background:#F6F7F9;padding:30rpx 0">
  <view class="card" style="margin-top:0">
    <view style="font-size:32rpx;font-weight:700;color:#F25B15;text-align:center;margin-bottom:40rpx">注册</view>

    <text class="field-label">学号</text><input class="inp" placeholder="请输入学号" aria-label="学号" bindinput="onF" data-key="student_id"/>
    <text class="field-label">姓名</text><input class="inp" placeholder="请输入姓名" aria-label="姓名" bindinput="onF" data-key="name"/>
    <text class="field-label">手机号</text><input class="inp" placeholder="请输入11位手机号" aria-label="手机号" type="number" maxlength="11" bindinput="onF" data-key="phone"/>
    <text class="field-label">班级</text><input class="inp" placeholder="请输入4位班级，如2502" aria-label="班级" bindinput="onF" data-key="class_name"/>
    <text class="field-label">密码</text><input class="inp" type="password" placeholder="字母加数字，至少6位" aria-label="密码" bindinput="onF" data-key="password"/>

    <button class="btn-primary btn-full" bindtap="doRegister" loading="{{l}}" disabled="{{l}}" aria-label="注册账号">注册</button>
    <button class="btn-outline btn-full" style="margin-top:16rpx" bindtap="goBack">返回</button>
  </view>
</view>
