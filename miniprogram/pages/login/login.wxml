<view class="page">
  <view class="card-login">
    <view class="brand">笃学书院</view>
    <view class="sub">空间预约系统</view>

    <view class="fields">
      <text class="field-label">学号</text>
      <input class="inp" aria-label="学号" placeholder="请输入学号" placeholder-style="font-size:26rpx;color:#bfb8c8" bindinput="onId" value="{{id}}"/>
      <text class="field-label">密码</text>
      <input class="inp" aria-label="密码" type="password" placeholder="请输入密码" placeholder-style="font-size:26rpx;color:#bfb8c8" bindinput="onPass" value="{{pw}}"/>
    </view>

    <button class="btn btn-full" bindtap="doLogin" loading="{{loading}}">登录</button>
    <view class="links">
      <text bindtap="goRegister" aria-role="button" aria-label="注册账号">注册账号</text>
      <text class="sep">|</text>
      <text bindtap="goForgot" aria-role="button" aria-label="忘记密码">忘记密码</text>
    </view>
  </view>
</view>
