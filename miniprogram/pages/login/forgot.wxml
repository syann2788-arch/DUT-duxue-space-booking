<view style="min-height:100vh;background:#f6f5f8;padding:30rpx 0">
  <view class="card" style="margin-top:0">
    <view style="font-size:32rpx;font-weight:700;color:#6b2d8e;text-align:center;margin-bottom:40rpx">重置密码</view>

    <view class="phone-row">
      <input class="inp-half" placeholder="手机号" type="number" bindinput="onPhone" value="{{phone}}"/>
      <button class="code-btn" bindtap="sendCode" loading="{{sending}}" disabled="{{countdown>0}}">{{countdown>0?countdown+'s':'获取验证码'}}</button>
    </view>

    <input class="inp" placeholder="验证码" type="number" bindinput="onCode" value="{{code}}"/>
    <input class="inp" type="password" placeholder="新密码（字母+数字，6位以上）" bindinput="onPw" value="{{newPw}}"/>
    <input class="inp" type="password" placeholder="确认新密码" bindinput="onConfirmPw" value="{{confirmPw}}"/>

    <button class="btn-primary btn-full" bindtap="reset" loading="{{submitting}}">重置密码</button>
    <button class="btn-outline btn-full" style="margin-top:16rpx" bindtap="goBack">返回登录</button>
  </view>
</view>
