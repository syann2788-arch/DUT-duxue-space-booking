<view style="min-height:100vh;background:#F6F7F9;padding:30rpx 0">
  <view class="card" style="margin-top:0">
    <view style="font-size:32rpx;font-weight:700;color:#F25B15;text-align:center;margin-bottom:40rpx">重置密码</view>

    <view class="reset-notice">
      <text class="reset-title">暂未开通短信找回</text>
      <text class="reset-copy">学校短信服务尚未接入。请联系辅导员或书院管理员，在核验本人身份后重置密码。</text>
    </view>

    <button class="btn-primary btn-full" bindtap="contactAdmin">查看处理方式</button>
    <button class="btn-outline btn-full" style="margin-top:16rpx" bindtap="goBack">返回登录</button>
  </view>
</view>
