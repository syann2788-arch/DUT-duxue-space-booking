.page { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(180deg, #F1EDFB 0%, #F6F7F9 60%); padding: 40rpx; }
.card-login { width: 100%; max-width: 600rpx; background: #fff; border-radius: 24rpx; padding: 60rpx 48rpx 48rpx; border: 1rpx solid #ECEEF2; box-shadow: 0 6rpx 24rpx rgba(23,28,36,0.05); display: flex; flex-direction: column; align-items: center; }
.logo { width: 120rpx; height: 120rpx; margin-bottom: 16rpx; }
.brand { font-size: 36rpx; font-weight: 700; color: #F25B15; text-align: center; }
.sub { font-size: 26rpx; color: #F5C9B0; text-align: center; margin-top: 8rpx; margin-bottom: 52rpx; }
.fields { margin-bottom: 36rpx; }
.field-label { display: block; width: 100%; margin: 0 0 10rpx; color: #667180; font-size: 24rpx; }
.inp { width: 100%; height: 88rpx; padding: 0 20rpx; border: 2rpx solid #ECEEF2; border-radius: 12rpx; font-size: 28rpx; color: #2c2c2c; line-height: 88rpx; margin-bottom: 24rpx; box-sizing: border-box; background: #F6F7F9; }
.btn { background: #F25B15; color: #fff; border: none; font-size: 32rpx; font-weight: 600; box-shadow: 0 5px 12px rgba(242,91,21,0.22); }
.btn[disabled] { background: #F5C9B0; }
.links { display: flex; justify-content: center; align-items: center; gap: 20rpx; margin-top: 28rpx; }
.links text { font-size: 26rpx; color: #F25B15; padding: 10rpx 0; }
.sep { color: #ECEEF2 !important; }
