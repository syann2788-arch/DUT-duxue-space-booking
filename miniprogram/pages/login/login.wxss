.page { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #F6F7F9; padding: 40rpx; }
.card-login { width: 100%; max-width: 600rpx; background: #fff; border-radius: 24rpx; padding: 60rpx 48rpx 48rpx; }
.brand { font-size: 44rpx; font-weight: 700; color: #F25B15; text-align: center; }
.sub { font-size: 26rpx; color: #F5C9B0; text-align: center; margin-top: 8rpx; margin-bottom: 52rpx; }
.fields { margin-bottom: 36rpx; }
.inp { width: 100%; height: 88rpx; padding: 0 16rpx; border-bottom: 2rpx solid #eee; font-size: 30rpx; color: #2c2c2c; line-height: 88rpx; margin-bottom: 12rpx; box-sizing: border-box; }
.btn { background: #F25B15; color: #fff; border: none; font-size: 32rpx; font-weight: 600; }
.btn[disabled] { background: #F5C9B0; }
.links { display: flex; justify-content: center; align-items: center; gap: 20rpx; margin-top: 28rpx; }
.links text { font-size: 26rpx; color: #F25B15; padding: 10rpx 0; }
.sep { color: #ECEEF2 !important; }
