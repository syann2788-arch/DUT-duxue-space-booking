.page { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(180deg, #F3EDF5 0%, #F8F6FA 60%); padding: 40rpx; }
.card-login { width: 100%; max-width: 600rpx; background: #fff; border-radius: 24rpx; padding: 60rpx 48rpx 48rpx; border: 1rpx solid #EAE3ED; box-shadow: 0 6rpx 24rpx rgba(23,28,36,0.05); display: flex; flex-direction: column; align-items: center; }
.brand { font-size: 36rpx; font-weight: 700; color: #612276; text-align: center; }
.sub { font-size: 26rpx; color: #DCCFE1; text-align: center; margin-top: 8rpx; margin-bottom: 52rpx; }
.fields { margin-bottom: 36rpx; }
.field-label { display: block; align-self: stretch; margin: 14rpx 0 8rpx; color: #667180; font-size: 24rpx; font-weight: 600; }
.inp { width: 100%; height: 88rpx; padding: 0 20rpx; border: 2rpx solid #EAE3ED; border-radius: 12rpx; font-size: 28rpx; color: #333333; line-height: 88rpx; margin-bottom: 24rpx; box-sizing: border-box; background: #F8F6FA; }
.btn { background: #612276; color: #fff; border: none; font-size: 32rpx; font-weight: 600; box-shadow: 0 5px 12px rgba(97,34,118,0.22); }
.btn[disabled] { background: #DCCFE1; }
.links { display: flex; justify-content: center; align-items: center; gap: 20rpx; margin-top: 28rpx; }
.links text { font-size: 26rpx; color: #612276; padding: 10rpx 0; }
.sep { color: #EAE3ED !important; }
