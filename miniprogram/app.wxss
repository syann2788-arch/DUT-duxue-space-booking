page { --purple: #6b2d8e; --bg: #f6f5f8; --card: #fff; --text: #2c2c2c; --sub: #999; --border: #eee; font-size: 28rpx; color: var(--text); background: var(--bg); }

.card { background: var(--card); margin: 20rpx; padding: 30rpx; border-radius: 20rpx; box-shadow: 0 4rpx 24rpx rgba(0,0,0,.03); }

.btn-primary { background: var(--purple); color: #fff; border-radius: 14rpx; font-weight: 600; border: none; }
.btn-primary[disabled] { background: #dcd0e8; color: #bbb; }

.btn-outline { background: #fff; color: var(--purple); border: 2rpx solid var(--purple); border-radius: 14rpx; }

.btn-full { width: 100%; padding: 26rpx; font-size: 30rpx; border-radius: 16rpx; }

.tag-res { background: #f1e7f7; color: var(--purple); font-size: 18rpx; padding: 4rpx 14rpx; border-radius: 6rpx; }
.tag-pub { background: #e4edfb; color: #3b7ad9; font-size: 18rpx; padding: 4rpx 14rpx; border-radius: 6rpx; }
.tag-cou { background: #fce4e7; color: #c0392b; font-size: 18rpx; padding: 4rpx 14rpx; border-radius: 6rpx; }
.tag-gray { background: #eee; color: #999; font-size: 18rpx; padding: 4rpx 14rpx; border-radius: 6rpx; }
