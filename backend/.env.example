ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./shuyuan.db
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
UPLOAD_DIR=./uploads
ENABLE_SCHEDULER=true
ALLOW_OPEN_REGISTRATION=true

# Optional one-time local bootstrap. Production values must be injected by the
# deployment system and removed after the first administrator signs in.
BOOTSTRAP_ADMIN_STUDENT_ID=
BOOTSTRAP_ADMIN_PASSWORD=

# Fill these only on the server; never commit the real AppSecret.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_SUBMITTED=
WECHAT_TEMPLATE_REVIEW=
WECHAT_TEMPLATE_REMINDER=
WECHAT_TEMPLATE_RESTRICTION=
